#. module: bs_checkout_fields
#: model:ir.model.fields,help:bs_checkout_fields.field_website_checkout_field__visibility
msgid "A hidden field is not rendered and its value is left untouched on addresses that already carry one."
msgstr "Скрытое поле не выводится, а его значение остаётся неизменным у адресов, где оно уже заполнено."

#. module: bs_checkout_fields
#: model:ir.model.fields,help:bs_checkout_fields.field_website_checkout_field__required
